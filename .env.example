# Token de tu bot de Telegram obtenido desde @BotFather
TELEGRAM_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Directorio donde se guardan las fotos y archivos de inspección
STORAGE_PATH=/app/storage

# Directorio donde se guarda el archivo de sesiones
SESSION_DIR=/app/storage

# Proxy HTTP/SOCKS5 (opcional, dejar vacío si no se usa)
PROXY_URL=

# Puerto web para ver y descargar fotos en FileBrowser
FILEBROWSER_PORT=8080
